{
  "info": {
    "name": "Expense Tracker API",
    "description": "Postman collection for the Expense Tracker API — auth, users, transactions, categories, and groups. Generated from the actual Spring Boot controllers.\n\nSet the `baseUrl` collection variable (default: http://localhost:8080). The `token` variable is set automatically after a successful Register or Login request. All IDs are UUIDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('Token saved to collection variable.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"securepassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user. Password must be 8-255 characters. Response: { \"token\": \"<JWT>\" } — saved automatically to the `token` collection variable."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('Token saved to collection variable.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"securepassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login. Response: { \"token\": \"<JWT>\" } — saved automatically to the `token` collection variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Get the authenticated user's profile: { id, name, email, createdAt, updatedAt }."
          },
          "response": []
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"email\": \"newemail@example.com\",\n  \"password\": \"newpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Update the authenticated user's profile. All fields (name, email, password) are optional. Response: Updated user profile."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create a Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionType\": \"Expense\",\n  \"amount\": 150.0,\n  \"description\": \"Groceries\",\n  \"categoryId\": \"<category-uuid>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "Create a transaction. Required: transactionType, amount (positive), categoryId (UUID). Optional: description. Response: Created transaction."
          },
          "response": []
        },
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "Get all transactions for the authenticated user. No query-parameter filtering is supported yet."
          },
          "response": []
        },
        {
          "name": "Get a Single Transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "Transaction ID (UUID)"
                }
              ]
            },
            "description": "Get details of a single transaction by UUID."
          },
          "response": []
        },
        {
          "name": "Update a Transaction",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Expense\",\n  \"categoryId\": \"<category-uuid>\",\n  \"amount\": 200.0,\n  \"date\": \"2024-11-30T00:00:00\",\n  \"description\": \"Updated groceries\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "Transaction ID (UUID)"
                }
              ]
            },
            "description": "Update a transaction. All fields optional. Note: `date` is a LocalDateTime (e.g. 2024-11-30T00:00:00). Response: Updated transaction."
          },
          "response": []
        },
        {
          "name": "Delete a Transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "Transaction ID (UUID)"
                }
              ]
            },
            "description": "Delete a transaction by UUID. Response: Empty body on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create a Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Food\",\n  \"description\": \"Expenses for food and dining\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Create a category. `name` is required (max 255 chars); `description` is optional. Response: Created category."
          },
          "response": []
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Get all categories for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Update a Category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "Category ID (UUID)"
                }
              ]
            },
            "description": "Update a category by UUID. Response: Updated category."
          },
          "response": []
        },
        {
          "name": "Delete a Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "Category ID (UUID)"
                }
              ]
            },
            "description": "Delete a category by UUID. Response: Empty body on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create a Group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Roommates\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/groups",
              "host": ["{{baseUrl}}"],
              "path": ["groups"]
            },
            "description": "Create a group. `name` is required (max 255 chars). Response: Created group."
          },
          "response": []
        },
        {
          "name": "Get Group Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups/:id",
              "host": ["{{baseUrl}}"],
              "path": ["groups", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "Group ID (UUID)"
                }
              ]
            },
            "description": "Get group detail: list of users in the group."
          },
          "response": []
        },
        {
          "name": "Add User to Group",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"<group-uuid>\",\n  \"userId\": \"<user-uuid>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/groups/add-user",
              "host": ["{{baseUrl}}"],
              "path": ["groups", "add-user"]
            },
            "description": "Add a user to a group. Both groupId and userId are required UUIDs. Response: 204 No Content."
          },
          "response": []
        }
      ]
    }
  ]
}
